{
  "version": "2.0.0",
  "schemaVersion": 1,
  "description": "Workspace hook registry for orchestrator lifecycle enforcement.",
  "hooks": {
    "PreToolUse": [
      {
        "id": "agent-prefetch",
        "type": "command",
        "script": ".github/hooks/scripts/agent_prefetch.py",
        "command": "python3 .github/hooks/scripts/agent_prefetch.py",
        "windows": "py -3 .github/hooks/scripts/agent_prefetch.py",
        "linux": "python3 .github/hooks/scripts/agent_prefetch.py",
        "osx": "python3 .github/hooks/scripts/agent_prefetch.py",
        "cwd": "./",
        "timeout": 30,
        "failMode": "error",
        "description": "Load and validate agent metadata, build registry"
      },
      {
        "id": "agent-sync-verify",
        "type": "command",
        "script": ".github/hooks/scripts/agent_sync_verify.py",
        "command": "python3 .github/hooks/scripts/agent_sync_verify.py",
        "windows": "py -3 .github/hooks/scripts/agent_sync_verify.py",
        "linux": "python3 .github/hooks/scripts/agent_sync_verify.py",
        "osx": "python3 .github/hooks/scripts/agent_sync_verify.py",
        "cwd": "./",
        "timeout": 20,
        "failMode": "error",
        "description": "Verify agent communication paths and build DAG"
      },
      {
        "id": "decision-coherence",
        "type": "command",
        "script": ".github/hooks/scripts/decision_coherence.py",
        "command": "python3 .github/hooks/scripts/decision_coherence.py",
        "windows": "py -3 .github/hooks/scripts/decision_coherence.py",
        "linux": "python3 .github/hooks/scripts/decision_coherence.py",
        "osx": "python3 .github/hooks/scripts/decision_coherence.py",
        "cwd": "./",
        "timeout": 15,
        "failMode": "error",
        "description": "Validate orchestrator routing rules for coherence"
      },
      {
        "id": "public-exposure-gate",
        "type": "command",
        "script": ".github/hooks/scripts/public_exposure_gate.py",
        "command": "python3 .github/hooks/scripts/public_exposure_gate.py",
        "windows": "py -3 .github/hooks/scripts/public_exposure_gate.py",
        "linux": "python3 .github/hooks/scripts/public_exposure_gate.py",
        "osx": "python3 .github/hooks/scripts/public_exposure_gate.py",
        "cwd": "./",
        "timeout": 20,
        "failMode": "error",
        "description": "Prevent unauthorized public internet exposure via Docker/ngrok"
      },
      {
        "id": "static-gatekeeper",
        "type": "command",
        "script": ".github/hooks/scripts/static_gatekeeper.py",
        "command": "python3 .github/hooks/scripts/static_gatekeeper.py",
        "windows": "py -3 .github/hooks/scripts/static_gatekeeper.py",
        "linux": "python3 .github/hooks/scripts/static_gatekeeper.py",
        "osx": "python3 .github/hooks/scripts/static_gatekeeper.py",
        "cwd": "./",
        "timeout": 60,
        "failMode": "error",
        "description": "Buffer-based dynamic syntax and policy verification"
      },
      {
        "id": "hllm-regex-preflight",
        "type": "command",
        "script": ".github/hooks/scripts/hllm_regex_preflight.py",
        "command": "python3 .github/hooks/scripts/hllm_regex_preflight.py",
        "windows": "py -3 .github/hooks/scripts/hllm_regex_preflight.py",
        "linux": "python3 .github/hooks/scripts/hllm_regex_preflight.py",
        "osx": "python3 .github/hooks/scripts/hllm_regex_preflight.py",
        "cwd": "./",
        "timeout": 20,
        "failMode": "error",
        "description": "Pattern matching guard against secrets and slop"
      }
    ],
    "PostToolUse": [
      {
        "id": "test-tracking-gate",
        "type": "command",
        "script": ".github/hooks/scripts/test_tracking_gate.py",
        "command": "python3 .github/hooks/scripts/test_tracking_gate.py",
        "windows": "py -3 .github/hooks/scripts/test_tracking_gate.py",
        "linux": "python3 .github/hooks/scripts/test_tracking_gate.py",
        "osx": "python3 .github/hooks/scripts/test_tracking_gate.py",
        "cwd": "./",
        "timeout": 20,
        "failMode": "error",
        "description": "Track failing tests and enforce binary fail-to-pass / pass-to-pass gates"
      },
      {
        "id": "completion-keyword-guard",
        "type": "command",
        "script": ".github/hooks/scripts/completion_keyword_guard.py",
        "command": "python3 .github/hooks/scripts/completion_keyword_guard.py",
        "windows": "py -3 .github/hooks/scripts/completion_keyword_guard.py",
        "linux": "python3 .github/hooks/scripts/completion_keyword_guard.py",
        "osx": "python3 .github/hooks/scripts/completion_keyword_guard.py",
        "cwd": "./",
        "timeout": 20,
        "failMode": "error",
        "description": "Verify continual learning keywords and pending failure clearance"
      },
      {
        "id": "continual-learning-checkpoint",
        "type": "command",
        "script": ".github/hooks/scripts/continual_learning_checkpoint.py",
        "command": "python3 .github/hooks/scripts/continual_learning_checkpoint.py",
        "windows": "py -3 .github/hooks/scripts/continual_learning_checkpoint.py",
        "linux": "python3 .github/hooks/scripts/continual_learning_checkpoint.py",
        "osx": "python3 .github/hooks/scripts/continual_learning_checkpoint.py",
        "cwd": "./",
        "timeout": 20,
        "failMode": "error",
        "description": "Unified continual learning checkpoint facade"
      }
    ]
  }
}
