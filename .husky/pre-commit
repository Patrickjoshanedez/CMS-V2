#!/usr/bin/env sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[Git Hook] Step 1/3: Checking Workspace Guardrails & Memory Namespaces..."
python "$REPO_ROOT/scripts/workspace_guardrail.py"

echo "[Git Hook] Step 2/3: Validating Agentic Governance & Security Policies..."
npm run validate:agentic

echo "[Git Hook] Step 3/3: Running lint-staged on changed files..."
npx lint-staged --cwd "$REPO_ROOT"
